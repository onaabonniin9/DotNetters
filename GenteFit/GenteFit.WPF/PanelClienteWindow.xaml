<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:GenteFit.WPF" x:Class="GenteFit.WPF.PanelClienteWindow" mc:Ignorable="d" Title="GenteFit - Panel de Cliente" Height="720" Width="1024" MinHeight="600" MinWidth="800" WindowStartupLocation="CenterScreen" Background="#FBF8F1" FontFamily="Poppins">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:CabeceraClienteControl Grid.Row="0" Margin="0,0,0,12" InicioSolicitado="Cabecera_InicioSolicitado" CerrarSesionSolicitado="Cabecera_CerrarSesionSolicitado"/><StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">

            <Viewbox Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,15">

                <Canvas Width="166" Height="166">

                    <Ellipse Width="156" Height="156" Canvas.Left="5" Canvas.Top="5" Stroke="#17483D" StrokeThickness="9"/>

                    <Rectangle Width="102" Height="12" Canvas.Left="32" Canvas.Top="77" Fill="#17483D"/>

                    <Rectangle Width="15" Height="44" RadiusX="7" RadiusY="7" Canvas.Left="29" Canvas.Top="61" Fill="#17483D"/>

                    <Rectangle Width="15" Height="44" RadiusX="7" RadiusY="7" Canvas.Left="122" Canvas.Top="61" Fill="#17483D"/>

                    <Rectangle Width="15" Height="36" RadiusX="7" RadiusY="7" Canvas.Left="44" Canvas.Top="65" Fill="#8FA9A1"/>

                    <Rectangle Width="15" Height="36" RadiusX="7" RadiusY="7" Canvas.Left="107" Canvas.Top="65" Fill="#8FA9A1"/>
                </Canvas>
            </Viewbox>

            <TextBlock HorizontalAlignment="Center" FontFamily="DM Sans" FontSize="32" FontWeight="Bold" Margin="0,0,0,5">
                <Run Text="Gente" Foreground="#17483D"/>
                <Run Text="Fit" Foreground="#8FA9A1"/>
            </TextBlock>

            <TextBlock Text="YOGA · BODYPUMP · FITNESS" FontSize="12" FontWeight="Bold" Foreground="#17483D" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock x:Name="TxtBienvenida" Text="¡Bienvenido/a!" FontSize="24" FontWeight="Bold" Foreground="#17483D" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="¿Qué quieres hacer hoy?" FontSize="16" Foreground="#252A27" HorizontalAlignment="Center" Margin="0,0,0,35"/>

            <Button x:Name="BtnVerHorario" Height="50" Margin="0,0,0,15" Background="#17483D" Foreground="White" FontWeight="SemiBold" FontSize="16" Cursor="Hand" Click="BtnVerHorario_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="20,0">

                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                                    <TextBlock Text="📅" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="Ver horario" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="&gt;" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnMisReservas" Height="50" Margin="0,0,0,15" Background="#8FA9A1" Foreground="#17483D" FontWeight="SemiBold" FontSize="16" Cursor="Hand" Click="BtnMisReservas_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="20,0">

                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                                    <TextBlock Text="📋" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="Mis reservas" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="&gt;" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnMiPerfil" Height="50" Background="White" BorderBrush="#17483D" BorderThickness="1" Foreground="#17483D" FontWeight="SemiBold" FontSize="16" Cursor="Hand" Click="BtnMiPerfil_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="20,0">

                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                                    <TextBlock Text="👤" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="Mi perfil" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="&gt;" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    <componentes:CabeceraComun Grid.Row="0" Rol="Cliente"/></Grid>
</Window>