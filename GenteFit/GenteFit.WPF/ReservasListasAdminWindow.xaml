<Window x:Class="GenteFit.WPF.ReservasListasAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenteFit - Reservas y listas de espera"
        Width="1250" Height="760" MinWidth="900" MinHeight="570"
        WindowStartupLocation="CenterOwner" Background="#FBF8F1" FontFamily="Poppins">
    <Window.Resources>
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D5E2DA"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EEE9"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="58"/>
            <Setter Property="ColumnHeaderHeight" Value="54"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F6FAF8"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9F1EC"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#D5E2DA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF4EE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCECE3"/>
                    <Setter Property="Foreground" Value="#17483D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="TextoCelda" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        <Style x:Key="TextoEstado" TargetType="TextBlock" BasedOn="{StaticResource TextoCelda}">
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="CANCELADA">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="CANCELADA POR CENTRO">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="RETIRADO">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="42,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Reservas y listas de espera" FontSize="29" FontWeight="Bold" Foreground="#17483D"/>
                <TextBlock Text="Consulta administrativa de las reservas y la cola de espera de GenteFit"
                           Foreground="#71877F" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button x:Name="ActualizarButton" Grid.Column="1" Content="Actualizar" Width="132"
                    Background="#3C7667" Style="{StaticResource BotonRedondeado}"
                    Click="Actualizar_Click" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="EstadoTextBlock" Grid.Row="1" Foreground="#71877F"
                   FontSize="13" Margin="0,0,0,14"/>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Buscar" Foreground="#17483D" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="BuscarTextBox" Grid.Column="1" Height="40"
                     Padding="12,8" VerticalContentAlignment="Center"
                     BorderBrush="#B9D0C3" BorderThickness="1" FontSize="14"
                     ToolTip="Filtrar por ID, sesión, actividad, cliente, usuario, estado o fecha"
                     TextChanged="BuscarTextBox_TextChanged"/>
        </Grid>

        <TabControl Grid.Row="3" Background="White" BorderBrush="#C8D8D0" FontSize="14">
            <TabItem Header="Reservas" Padding="20,9">
                <Grid>
                    <DataGrid x:Name="ReservasDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCelda}" Width="55"/>
                            <DataGridTextColumn Header="Sesión" Binding="{Binding SesionId}" ElementStyle="{StaticResource TextoCelda}" Width="70"/>
                            <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" ElementStyle="{StaticResource TextoCelda}" Width="2*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" ElementStyle="{StaticResource TextoCelda}" Width="110"/>
                            <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" ElementStyle="{StaticResource TextoCelda}" Width="70"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" ElementStyle="{StaticResource TextoCelda}" Width="2*"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" ElementStyle="{StaticResource TextoCelda}" Width="1.4*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="1.6*"/>
                            <DataGridTextColumn Header="Creada" Binding="{Binding FechaReserva}" ElementStyle="{StaticResource TextoCelda}" Width="155"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SinReservasTextBlock" Text="No hay reservas que mostrar."
                               Foreground="#71877F" FontSize="16" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
            <TabItem Header="Listas de espera" Padding="20,9">
                <Grid>
                    <DataGrid x:Name="ListasDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCelda}" Width="55"/>
                            <DataGridTextColumn Header="Sesión" Binding="{Binding SesionId}" ElementStyle="{StaticResource TextoCelda}" Width="70"/>
                            <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" ElementStyle="{StaticResource TextoCelda}" Width="2*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" ElementStyle="{StaticResource TextoCelda}" Width="110"/>
                            <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" ElementStyle="{StaticResource TextoCelda}" Width="70"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" ElementStyle="{StaticResource TextoCelda}" Width="2*"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" ElementStyle="{StaticResource TextoCelda}" Width="1.5*"/>
                            <DataGridTextColumn Header="Posición" Binding="{Binding Posicion}" ElementStyle="{StaticResource TextoCelda}" Width="85"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SinListasTextBlock" Text="No hay entradas en lista de espera que mostrar."
                               Foreground="#71877F" FontSize="16" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="4" Content="Cerrar" Width="160" Background="#17483D"
                HorizontalAlignment="Right" Margin="0,18,0,0"
                Style="{StaticResource BotonRedondeado}" Click="Cerrar_Click"/>
    </Grid>
</Window>
