<Window x:Class="GenteFit.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenteFit - Inicio de sesión"
        Width="1100" Height="700"
        MinWidth="650" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FBF8F1"
        FontFamily="Poppins">

    <Window.Resources>
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#252A27"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#17483D"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Width="404"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,40">

            <!-- Logotipo GenteFit -->
            <Canvas Width="166" Height="166"
                    HorizontalAlignment="Center">

                <Ellipse Width="156" Height="156"
                         Canvas.Left="5" Canvas.Top="5"
                         Stroke="#17483D"
                         StrokeThickness="9"/>

                <Rectangle Width="102" Height="12"
                           Canvas.Left="32" Canvas.Top="77"
                           Fill="#17483D"/>

                <Rectangle Width="15" Height="44"
                           RadiusX="7" RadiusY="7"
                           Canvas.Left="29" Canvas.Top="61"
                           Fill="#17483D"/>

                <Rectangle Width="15" Height="44"
                           RadiusX="7" RadiusY="7"
                           Canvas.Left="122" Canvas.Top="61"
                           Fill="#17483D"/>

                <Rectangle Width="15" Height="36"
                           RadiusX="7" RadiusY="7"
                           Canvas.Left="44" Canvas.Top="65"
                           Fill="#8FA9A1"/>

                <Rectangle Width="15" Height="36"
                           RadiusX="7" RadiusY="7"
                           Canvas.Left="107" Canvas.Top="65"
                           Fill="#8FA9A1"/>
            </Canvas>

            <!-- Nombre de la aplicación -->
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="DM Sans"
                       FontSize="52"
                       FontWeight="Bold"
                       Margin="0,14,0,40">
                <Run Text="Gente" Foreground="#17483D"/>
                <Run Text="Fit" Foreground="#8FA9A1"/>
            </TextBlock>

            <!-- Campo usuario -->
            <Border Height="55"
                    Background="#C8D1D9"
                    BorderBrush="#8FA9A1"
                    BorderThickness="2"
                    CornerRadius="11"
                    Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Canvas Width="28" Height="32"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Ellipse Width="16" Height="16"
                                 Canvas.Left="6" Canvas.Top="1"
                                 Fill="#17483D"/>
                        <Path Data="M 1,31 L 1,27 C 1,17 27,17 27,27 L 27,31 Z"
                              Fill="#17483D"/>
                    </Canvas>

                    <Grid Grid.Column="1" Margin="0,0,15,0">
                        <TextBox x:Name="UsuarioTextBox"
                                 Style="{StaticResource CampoTexto}"
                                 AutomationProperties.Name="Usuario"/>

                        <TextBlock Text="Usuario"
                                   Foreground="#777777"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UsuarioTextBox}"
                                                     Value="">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Campo contraseña -->
            <Border Height="55"
                    Background="#C8D1D9"
                    BorderBrush="#8FA9A1"
                    BorderThickness="2"
                    CornerRadius="11"
                    Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>

                    <!-- Candado -->
                    <Canvas Width="28" Height="34"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <Path Data="M 7,15 L 7,10 C 7,-1 21,-1 21,10 L 21,15"
                              Stroke="#17483D"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>

                        <Rectangle Width="23" Height="19"
                                   Canvas.Left="2.5" Canvas.Top="14"
                                   Fill="#17483D"
                                   RadiusX="2" RadiusY="2"/>

                        <Ellipse Width="5" Height="5"
                                 Canvas.Left="11.5" Canvas.Top="20"
                                 Fill="#C8D1D9"/>

                        <Rectangle Width="2" Height="6"
                                   Canvas.Left="13" Canvas.Top="23"
                                   Fill="#C8D1D9"/>
                    </Canvas>

                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="ContrasenaPasswordBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#252A27"
                                     FontSize="18"
                                     VerticalContentAlignment="Center"
                                     PasswordChanged="ContrasenaPasswordBox_PasswordChanged"
                                     AutomationProperties.Name="Contraseña"/>

                        <TextBox x:Name="ContrasenaVisibleTextBox"
                                 Style="{StaticResource CampoTexto}"
                                 Visibility="Collapsed"
                                 TextChanged="ContrasenaVisibleTextBox_TextChanged"
                                 AutomationProperties.Name="Contraseña visible"/>

                        <TextBlock x:Name="ContrasenaPlaceholder"
                                   Text="Contraseña"
                                   Foreground="#777777"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Separador -->
                    <Border Grid.Column="2"
                            Width="1"
                            Height="20"
                            Background="#8FA9A1"
                            VerticalAlignment="Center"/>

                    <!-- Mostrar u ocultar contraseña -->
                    <Button x:Name="MostrarContrasenaButton"
                            Grid.Column="3"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MostrarContrasena_Click"
                            ToolTip="Mostrar u ocultar contraseña"
                            AutomationProperties.Name="Mostrar u ocultar contraseña">

                        <Viewbox Width="32" Height="24">
                            <Canvas Width="32" Height="24">
                                <Path Data="M 1,12 Q 16,-2 31,12 Q 16,26 1,12 Z"
                                      Stroke="#252A27"
                                      StrokeThickness="2"
                                      Fill="Transparent"/>

                                <Ellipse Width="10" Height="10"
                                         Canvas.Left="11" Canvas.Top="7"
                                         Stroke="#252A27"
                                         StrokeThickness="2"/>

                                <Path x:Name="OjoTachado"
                                      Data="M 4,3 L 28,21"
                                      Stroke="#252A27"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Visible"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Iniciar sesión -->
            <Button x:Name="IniciarSesionButton"
                    Height="56"
                    Background="#17483D"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Content="Iniciar sesión"
                    IsDefault="True"
                    Click="IniciarSesion_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#8FA9A1"
                                BorderThickness="1"
                                CornerRadius="11">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Grid>
</Window>
