<Window x:Class="GenteFit.WPF.EditarActividadAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenteFit - Actividad"
        Width="600" Height="690" MinWidth="540" MinHeight="590"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FBF8F1" FontFamily="Poppins">
    <Window.Resources>
        <Style x:Key="Accion" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#C9DAD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="18" Margin="24" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock x:Name="TituloTextBlock" Text="Nueva actividad" FontSize="26" FontWeight="Bold" Foreground="#17483D"/>
                <TextBlock Text="Completa los datos de la actividad" FontSize="13" Foreground="#71877F" Margin="0,5,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,22,0">
                    <TextBlock Text="Nombre" Foreground="#3C7667" Margin="0,0,0,5"/>
                    <TextBox x:Name="NombreTextBox" MaxLength="150" Height="43" Margin="0,0,0,14"/>
                    <TextBlock Text="Descripción" Foreground="#3C7667" Margin="0,0,0,5"/>
                    <TextBox x:Name="DescripcionTextBox" MaxLength="1000" Height="84" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>
                    <TextBlock Text="Intensidad" Foreground="#3C7667" Margin="0,0,0,5"/>
                    <ComboBox x:Name="IntensidadComboBox" Height="43" FontSize="15" Foreground="#17483D"
                              Background="White" BorderBrush="#C9DAD3" Margin="0,0,0,14"/>
                    <TextBlock Text="Duración (minutos)" Foreground="#3C7667" Margin="0,0,0,5"/>
                    <TextBox x:Name="DuracionTextBox" Height="43" MaxLength="5"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar" Background="#81968D"
                        Style="{StaticResource Accion}" Click="Cancelar_Click"/>
                <Button x:Name="GuardarButton" Grid.Column="2" Content="Guardar actividad" Background="#17483D"
                        Style="{StaticResource Accion}" Click="Guardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
