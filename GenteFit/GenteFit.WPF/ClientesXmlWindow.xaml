<Window x:Class="GenteFit.WPF.ClientesXmlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenteFit - Clientes XML"
        Width="1100"
        Height="750"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#FBF8F1"
        FontFamily="Poppins, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Verde" Color="#17483D"/>
        <SolidColorBrush x:Key="VerdeClaro" Color="#8FA9A1"/>
        <SolidColorBrush x:Key="Texto" Color="#252A27"/>

        <!-- Tarjetas con el estilo del panel principal -->
        <Style x:Key="Tarjeta" TargetType="Button">
            <Setter Property="Height" Value="118"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Verde}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter Margin="30,10"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde"
                                        Property="Background"
                                        Value="#EDF3F0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Borde"
                                        Property="BorderThickness"
                                        Value="3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borde"
                                        Property="Background"
                                        Value="#DFEAE5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borde"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Verde}"/>
        </Style>

        <Style x:Key="DescripcionTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="Flecha" TargetType="TextBlock">
            <Setter Property="Text" Value="❯"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="60,40,60,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Logotipo GenteFit -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Viewbox Width="46" Height="46">
                    <Canvas Width="48" Height="48">
                        <Ellipse Canvas.Left="2" Canvas.Top="2"
                                 Width="44" Height="44"
                                 Stroke="{StaticResource Verde}"
                                 StrokeThickness="3"/>
                        <Rectangle Canvas.Left="10" Canvas.Top="22"
                                   Width="28" Height="4"
                                   Fill="{StaticResource Verde}"/>
                        <Rectangle Canvas.Left="8" Canvas.Top="17"
                                   Width="5" Height="14" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource Verde}"/>
                        <Rectangle Canvas.Left="13" Canvas.Top="19"
                                   Width="4" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource VerdeClaro}"/>
                        <Rectangle Canvas.Left="31" Canvas.Top="19"
                                   Width="4" Height="10" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource VerdeClaro}"/>
                        <Rectangle Canvas.Left="35" Canvas.Top="17"
                                   Width="5" Height="14" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource Verde}"/>
                    </Canvas>
                </Viewbox>

                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold">
                    <Run Text="Gente " Foreground="{StaticResource Verde}"/><Run Text="Fit" Foreground="{StaticResource VerdeClaro}"/>
                </TextBlock>
            </StackPanel>

            <!-- Perfil -->
            <Border Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="#C8D1D8"
                    BorderBrush="{StaticResource VerdeClaro}"
                    BorderThickness="1.5"
                    CornerRadius="22"
                    Padding="16,7">
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="23" Height="24">
                        <Ellipse Canvas.Left="7" Canvas.Top="1"
                                 Width="10" Height="10"
                                 Fill="{StaticResource Verde}"/>
                        <Path Data="M1,23 L1,20 C1,11 22,11 22,20 L22,23 Z"
                              Fill="{StaticResource Verde}"/>
                    </Canvas>
                    <TextBlock Text="Administrador"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource Verde}"/>
                </StackPanel>
            </Border>

            <!-- IsCancel cierra la ventana abierta con ShowDialog() -->
            <Button Grid.Column="2"
                    Content="←  Volver al panel"
                    IsCancel="True"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,6"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Verde}"
                    Cursor="Hand"/>
        </Grid>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="690" Margin="0,36,0,0">

                <TextBlock Text="Clientes XML"
                           HorizontalAlignment="Center"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="Black"
                           Margin="0,0,0,42"/>

                <!-- Importar -->
                <Button x:Name="BtnImportar"
                        Click="BtnImportar_Click"
                        AutomationProperties.Name="Importar clientes desde XML"
                        Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="50" Height="50"
                                 HorizontalAlignment="Left">
                            <Canvas Width="32" Height="32">
                                <Path Data="M16,3 L16,20 M9,13 L16,20 L23,13"
                                      Stroke="{StaticResource Verde}"
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M4,20 L4,28 L28,28 L28,20"
                                      Stroke="{StaticResource Verde}"
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Importar clientes"
                                       Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Selecciona un XML para añadir los clientes nuevos a GenteFit."
                                       Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Flecha}"/>
                    </Grid>
                </Button>

                <!-- Exportar -->
                <Button x:Name="BtnExportar"
                        Click="BtnExportar_Click"
                        AutomationProperties.Name="Exportar clientes a XML"
                        Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="50" Height="50"
                                 HorizontalAlignment="Left">
                            <Canvas Width="32" Height="32">
                                <Path Data="M16,21 L16,4 M9,11 L16,4 L23,11"
                                      Stroke="{StaticResource Verde}"
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M4,20 L4,28 L28,28 L28,20"
                                      Stroke="{StaticResource Verde}"
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Exportar clientes"
                                       Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Guarda los clientes registrados en GenteFit en un archivo XML."
                                       Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Flecha}"/>
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>