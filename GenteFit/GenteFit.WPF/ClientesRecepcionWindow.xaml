<Window x:Class="GenteFit.WPF.ClientesRecepcionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:componentes="clr-namespace:GenteFit.WPF.Components"
        Title="GenteFit - Clientes"
        Height="720" Width="1024" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#8FA9A1" FontFamily="Poppins">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <componentes:CabeceraComun Grid.Row="0" Rol="Recepción" Margin="45,12,45,0"/>

        <TextBlock Grid.Row="1" Text="Clientes" FontSize="30" FontWeight="Bold" Foreground="White" 
            HorizontalAlignment="Center" Margin="0,5,0,15"/>
        
        <componentes:BuscadorComun x:Name="Buscador" Grid.Row="2" Margin="105,0,105,12"
            Indicacion="Buscar por nombre, DNI, usuario o email"
            TextChanged="Buscador_TextChanged"/>
        
        <Grid Grid.Row="3" Margin="105,0,105,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        
        <TextBlock x:Name="TxtResumen" Grid.Row="0" Foreground="White" FontSize="13" Margin="4,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaClientes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FBF8F1" CornerRadius="4"
                                    Padding="16,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding NombreCompleto}"
                                               FontSize="14" Foreground="#252A27"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estado}"
                                               Foreground="{Binding ColorEstado}"
                                               FontWeight="Bold" FontSize="14"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="2" Content="Ver"
                                            Height="28" Background="#707070"
                                            Foreground="White" BorderThickness="0"
                                            IsEnabled="False"
                                            ToolTip="Se activará con la pantalla de detalle de cliente"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

