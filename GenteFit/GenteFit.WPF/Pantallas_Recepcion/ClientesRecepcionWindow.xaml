<Window x:Class="GenteFit.WPF.ClientesRecepcionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:componentes="clr-namespace:GenteFit.WPF.Components"
        Title="GenteFit - Clientes"
        Height="720" Width="1024" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#17483D" FontFamily="Poppins">

    <Window.Resources>
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Background" Value="#FBF8F1"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <componentes:CabeceraComun Grid.Row="0" Rol="Recepción" Margin="0,0,0,12" Foreground="#FBF8F1"/>

        <TextBlock Grid.Row="1" Text="Clientes" FontSize="30" FontWeight="Bold" Foreground="White" 
            HorizontalAlignment="Center" Margin="0,5,0,15"/>
        
        <componentes:BuscadorComun x:Name="Buscador" Grid.Row="2" Margin="0,0,0,12"
            Indicacion="Buscar por nombre, DNI, usuario o email"
            TextChanged="Buscador_TextChanged"/>
        
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        
        <TextBlock x:Name="TxtResumen" Grid.Row="0" Foreground="White" FontSize="13" Margin="4,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaClientes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FBF8F1" CornerRadius="12"
                                    Padding="16,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding NombreCompleto}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#252A27" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estado}"
                                               Foreground="{Binding ColorEstado}"
                                               FontWeight="Bold" FontSize="14"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="2" Content="Ver"
                                            Height="38" Background="#17483D" Style="{StaticResource BotonRedondeado}"
                                            Foreground="White" BorderThickness="0"
                                            Tag="{Binding Id}"
                                            Click="BtnVer_Click"
                                            />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <Button Grid.Row="4" Content="Cerrar" Width="120" Height="40"
                HorizontalAlignment="Right" Style="{StaticResource BotonRedondeado}" Click="BtnCerrar_Click"/>
    </Grid>
</Window>

