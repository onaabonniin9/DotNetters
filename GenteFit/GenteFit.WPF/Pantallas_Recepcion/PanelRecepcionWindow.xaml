<Window x:Class="GenteFit.WPF.PanelRecepcionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:componentes="clr-namespace:GenteFit.WPF.Components"
        Title="GenteFit - Panel de Recepción"
        Height="720" Width="1024" MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#FBF8F1" FontFamily="Poppins">

    <Window.Resources>
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <componentes:CabeceraComun Grid.Row="0" Rol="Recepción"
                                   Margin="45,12,45,0"/>

        <StackPanel Grid.Row="1" Width="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock x:Name="TxtBienvenida" Text="¡Bienvenido/a!"
                       FontSize="24" FontWeight="Bold" Foreground="#17483D"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="¿Qué quieres hacer hoy?" FontSize="14"
                       Foreground="#252A27" HorizontalAlignment="Center"
                       Margin="0,4,0,28"/>

            <Button Content="Clientes" Style="{StaticResource BotonMenu}"
                    Background="#17483D" Foreground="White"
                    Click="BtnClientes_Click"/>

            <Button Content="Ver horario"
                    Style="{StaticResource BotonMenu}"
                    Background="#C8D1D9" Foreground="#252A27"
                    Click="BtnHorario_Click"/>
        </StackPanel>
    </Grid>
</Window>