<UserControl x:Class="GenteFit.WPF.Components.BuscadorComun"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Poppins">
    <Border Height="48" Background="#EDF3F0" BorderBrush="#C8D8D0"
            BorderThickness="1" CornerRadius="9">
        <Grid>
            <TextBox x:Name="CampoBusqueda" Margin="16,0" FontSize="16"
                     Foreground="#17483D" Background="Transparent"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     TextChanged="CampoBusqueda_TextChanged"/>
            <TextBlock Margin="18,0" FontSize="16" Foreground="#82948A"
                       VerticalAlignment="Center" IsHitTestVisible="False"
                       Text="{Binding Indicacion, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=CampoBusqueda}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
