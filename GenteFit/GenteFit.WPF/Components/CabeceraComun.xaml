<UserControl x:Class="GenteFit.WPF.Components.CabeceraComun"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="#17483D" FontFamily="Poppins">
    <Grid MinHeight="55">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox x:Name="Logo" Width="48" Height="48">
                <Canvas Width="100" Height="100">
                    <Ellipse Width="90" Height="90" Canvas.Left="5" Canvas.Top="5"
                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="7"/>
                    <Rectangle Width="62" Height="7" Canvas.Left="19" Canvas.Top="46" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Rectangle Width="10" Height="27" Canvas.Left="18" Canvas.Top="36"
                               RadiusX="5" RadiusY="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Rectangle Width="10" Height="27" Canvas.Left="72" Canvas.Top="36"
                               RadiusX="5" RadiusY="5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Rectangle Width="9" Height="22" Canvas.Left="28" Canvas.Top="39"
                               RadiusX="4" RadiusY="4" Fill="#8FA9A1"/>
                    <Rectangle Width="9" Height="22" Canvas.Left="63" Canvas.Top="39"
                               RadiusX="4" RadiusY="4" Fill="#8FA9A1"/>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="Marca" FontFamily="DM Sans" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="8,0,0,0">
                <Run Text="Gente" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Run Text="Fit" Foreground="#8FA9A1"/>
            </TextBlock>
        </StackPanel>

        <Border Grid.Column="1" Background="#C8D1D9" BorderBrush="#8FA9A1"
                BorderThickness="2" CornerRadius="22" Height="42"
                Padding="15,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Canvas x:Name="IconoRol" Width="24" Height="27">
                    <Ellipse Width="12" Height="12" Canvas.Left="6" Canvas.Top="1" Fill="#17483D"/>
                    <Path Data="M 1,26 L 1,23 C 1,14 23,14 23,23 L 23,26 Z" Fill="#17483D"/>
                </Canvas>
                <TextBlock x:Name="TextoRol" Text="Usuario" FontSize="16" FontWeight="Bold"
                           Foreground="#17483D" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Button x:Name="BotonMenu" Grid.Column="2" HorizontalAlignment="Right"
                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                Cursor="Hand" Click="AbrirMenu_Click">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Inicio" Click="IrInicio_Click"/>
                    <Separator/>
                    <MenuItem Header="Cerrar sesión" Click="CerrarSesion_Click"/>
                </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TextoMenu" Text="Menú" FontSize="21" FontWeight="SemiBold"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Canvas x:Name="IconoMenu" Width="34" Height="30">
                    <Line X1="1" Y1="6" X2="33" Y2="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="2"/>
                    <Line X1="1" Y1="15" X2="33" Y2="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="2"/>
                    <Line X1="1" Y1="24" X2="33" Y2="24" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="2"/>
                </Canvas>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
