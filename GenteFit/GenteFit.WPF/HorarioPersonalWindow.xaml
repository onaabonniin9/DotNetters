<Window x:Class="GenteFit.WPF.HorarioPersonalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:componentes="clr-namespace:GenteFit.WPF.Components"
        Title="GenteFit - Horario"
        Height="720" Width="1024" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#8FA9A1" FontFamily="Poppins">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <componentes:CabeceraComun x:Name="Cabecera" Grid.Row="0" Margin="45,12,45,0"/>

        <TextBlock x:Name="TxtTitulo" Grid.Row="1" Text="Horario" FontSize="30"
                   FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,5,0,8"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,0,0,12">
            <Button Content="◀" Width="40" Height="30" Click="BtnAnterior_Click"/>
            <TextBlock x:Name="TxtRango" Foreground="White" FontSize="15" FontWeight="Bold"
                       Width="340" TextAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="▶" Width="40" Height="30" Click="BtnSiguiente_Click"/>
            <Button Content="Hoy" Width="70" Height="30" Margin="14,0,0,0"
                    Click="BtnHoy_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="105,0,105,25">
            <ItemsControl x:Name="ListaDias">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Titulo}" Foreground="White"
                                       FontWeight="Bold" FontSize="16" Margin="2,0,0,6"/>
                            <TextBlock Text="{Binding Vacio}" Foreground="White"
                                       Margin="2,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Sesiones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FBF8F1" CornerRadius="4"
                                                Padding="16,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Hora}"
                                                           FontWeight="Bold" Foreground="#252A27"
                                                           VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Actividad}" FontWeight="Bold"
                                                               Foreground="#252A27"/>
                                                    <TextBlock Text="{Binding Lugar}" FontSize="12"
                                                               Foreground="#525252"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Plazas}"
                                                           Foreground="#252A27" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="3" Text="{Binding Espera}"
                                                           Foreground="#252A27" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="4" Text="{Binding Estado}"
                                                           Foreground="{Binding ColorEstado}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>

                                                <Button Grid.Column="5" Content="Ver" Height="28"
                                                        Background="#707070" Foreground="White"
                                                        BorderThickness="0"
                                                        Tag="{Binding Id}" Click="BtnVer_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>