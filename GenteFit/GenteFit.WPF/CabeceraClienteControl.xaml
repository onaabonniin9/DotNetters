<UserControl x:Class="GenteFit.WPF.CabeceraClienteControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="66" FontFamily="Poppins" Background="Transparent">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">

                <Viewbox Width="48" Height="48">
                    <Canvas Width="100" Height="100">

                        <Ellipse Width="90" Height="90" Canvas.Left="5" Canvas.Top="5" Stroke="#17483D" StrokeThickness="7"/>

                        <Rectangle Width="62" Height="7" Canvas.Left="19" Canvas.Top="46" Fill="#17483D"/>

                        <Rectangle Width="10" Height="27" Canvas.Left="18" Canvas.Top="36" RadiusX="5" RadiusY="5" Fill="#17483D"/>

                        <Rectangle Width="10" Height="27" Canvas.Left="72" Canvas.Top="36" RadiusX="5" RadiusY="5" Fill="#17483D"/>

                        <Rectangle Width="9" Height="22" Canvas.Left="28" Canvas.Top="39" RadiusX="4" RadiusY="4" Fill="#8FA9A1"/>

                        <Rectangle Width="9" Height="22" Canvas.Left="63" Canvas.Top="39" RadiusX="4" RadiusY="4" Fill="#8FA9A1"/>
                    </Canvas>
                </Viewbox>

                <TextBlock FontFamily="DM Sans" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="Gente" Foreground="#17483D"/>
                    <Run Text="Fit" Foreground="#8FA9A1"/>
                </TextBlock>
            </StackPanel>

            
    <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Grid.Column="1" Height="42" Background="#C8D1D9" BorderBrush="#8FA9A1" BorderThickness="2" CornerRadius="22" Padding="15,0" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Canvas Width="24" Height="27">
                        <Ellipse Width="12" Height="12" Canvas.Left="6" Canvas.Top="1" Fill="#17483D"/>

                        <Path Data="M 1,26 L 1,23 C 1,14 23,14 23,23 L 23,26 Z" Fill="#17483D"/>
                    </Canvas>

                    <TextBlock Text="Cliente" FontSize="16" FontWeight="Bold" Foreground="#17483D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

    <Button x:Name="BtnMenu" Grid.Column="2" HorizontalAlignment="Right"
        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
        Foreground="#17483D" FontSize="19" FontWeight="SemiBold"
        Cursor="Hand" Padding="10,8" Click="AbrirMenu_Click">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Menú" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock Text="☰" FontSize="28" VerticalAlignment="Center"/>
      </StackPanel>
      <Button.ContextMenu>
        <ContextMenu FontFamily="Poppins" FontSize="14" Background="White">
          <MenuItem Header="Inicio" Click="Inicio_Click"/>
          <Separator/>
          <MenuItem Header="Cerrar sesión" Click="CerrarSesion_Click"/>
        </ContextMenu>
      </Button.ContextMenu>
    </Button>
  </Grid>
</UserControl>