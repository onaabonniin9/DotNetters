<Window x:Class="GenteFit.WPF.DetalleSesionPersonalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:componentes="clr-namespace:GenteFit.WPF.Components"
        Title="GenteFit - Detalle de sesión"
        Height="720" Width="1024" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#17483D" FontFamily="Poppins">

    <Window.Resources>

        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Background" Value="#FBF8F1"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#525252"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#252A27"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <componentes:CabeceraComun x:Name="Cabecera" Grid.Row="0" Margin="45,12,45,0" Foreground="#FBF8F1"/>

        <TextBlock Grid.Row="1" Text="Detalle de la sesión" FontSize="30" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,12"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="105,0,105,25">
                <Border Background="#FBF8F1" CornerRadius="12" Padding="22,16">
                    <StackPanel>
                        <TextBlock Text="ACTIVIDAD" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtActividad" Style="{StaticResource Valor}"/>
                        <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtDescripcion" Style="{StaticResource Valor}"/>
                        <TextBlock Text="FECHA Y HORA" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtFecha" Style="{StaticResource Valor}"/>
                        <TextBlock Text="MONITOR" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtMonitor" Style="{StaticResource Valor}"/>
                        <TextBlock Text="NIVEL DE INTENSIDAD" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtNivel" Style="{StaticResource Valor}"/>
                        <TextBlock Text="UBICACIÓN" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtSala" Style="{StaticResource Valor}"/>
                        <TextBlock Text="PLAZAS" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtPlazas" Style="{StaticResource Valor}"/>
                        <TextBlock Text="ESTADO" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtEstado" Style="{StaticResource Valor}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelReservas" Background="#FBF8F1" CornerRadius="12"
                        Padding="22,16" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="RESERVAS" Style="{StaticResource Etiqueta}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtSinReservas" Text="Todavía no hay reservas confirmadas."
                                   Foreground="#525252" Visibility="Collapsed"/>
                        <ItemsControl x:Name="ListaReservas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Cliente}"
                                                   Foreground="#252A27"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Fecha}"
                                                   Foreground="#525252"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="3" Content="Cerrar" Width="120" Height="40"
                HorizontalAlignment="Right" Margin="0,0,30,24"
                Style="{StaticResource BotonRedondeado}" Click="BtnVolver_Click"/>
    </Grid>
</Window>