<Window x:Class="GenteFit.WPF.PanelMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:componentes="clr-namespace:GenteFit.WPF.Components"
        Title="GenteFit - Panel de Monitor"
        Height="720" Width="1024" MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#FBF8F1" FontFamily="Poppins">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <componentes:CabeceraComun Grid.Row="0" Rol="Monitor" Margin="45,12,45,0"/>

        <StackPanel Grid.Row="1" Width="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtBienvenida" Text="¡Bienvenido/a!"
                       FontSize="24" FontWeight="Bold" Foreground="#17483D"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="¿Qué quieres hacer hoy?" FontSize="14"
                       Foreground="#252A27" HorizontalAlignment="Center"
                       Margin="0,4,0,28"/>
            <Button Content="Mi horario" Height="46" FontSize="15" FontWeight="Bold"
                    Background="#17483D" Foreground="White"
                    Click="BtnHorario_Click"/>
        </StackPanel>
    </Grid>
</Window>