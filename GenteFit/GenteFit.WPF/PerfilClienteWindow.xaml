<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GenteFit.WPF" x:Class="GenteFit.WPF.PerfilClienteWindow" Title="GenteFit - Perfil del Cliente" Height="768" Width="1024" MinHeight="650" MinWidth="850" WindowStartupLocation="CenterScreen" Background="#FBF8F1" FontFamily="Poppins">

    <Window.Resources>
        <Style x:Key="CampoPerfil" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#252A27"/>
            <Setter Property="Background" Value="#EDF3F0"/>
            <Setter Property="BorderBrush" Value="#C8D1D9"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="EtiquetaPerfil" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="BotonPerfil" TargetType="Button">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:CabeceraClienteControl Grid.Row="0" Margin="30,12,30,0" InicioSolicitado="Cabecera_InicioSolicitado" CerrarSesionSolicitado="Cabecera_CerrarSesionSolicitado"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,18">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock Text="Mi perfil" FontSize="28" FontWeight="Bold" Foreground="#17483D" HorizontalAlignment="Center" Margin="0,8,0,18"/>

                <Border Background="White" BorderBrush="#C8D1D9" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Datos personales" FontSize="18" FontWeight="Bold" Foreground="#17483D" Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Nombre" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtNombre" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Apellidos" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtApellidos" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Nombre de usuario" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtUsuario" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Email" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtEmail" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Teléfono" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtTelefono" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="DNI" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtDNI" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Fecha de nacimiento" Style="{StaticResource EtiquetaPerfil}"/>
                                <DatePicker x:Name="DpFechaNacimiento" Height="40" FontFamily="Poppins" FontSize="14" Background="#EDF3F0" Foreground="#252A27" BorderBrush="#C8D1D9" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Dirección" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtDireccion" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Ciudad" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtCiudad" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Código postal" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtCodigoPostal" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="IBAN" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtIban" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="BtnEditarPerfil" Height="48" Content="Editar perfil" Width="140" Background="#17483D" Foreground="White" Style="{StaticResource BotonPerfil}" Click="EditarPerfil_Click" Margin="0,0,10,8"/>

                            <Button x:Name="BtnGuardarPerfil" Height="48" Content="Guardar cambios" Width="155" Background="#17483D" Foreground="White" Style="{StaticResource BotonPerfil}" Visibility="Collapsed" Click="GuardarPerfil_Click" Margin="0,0,10,8"/>

                            <Button x:Name="BtnCancelarEdicion" Height="48" Content="Cancelar" Width="110" Background="#C8D1D9" Foreground="#252A27" Style="{StaticResource BotonPerfil}" Visibility="Collapsed" Click="CancelarEdicion_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- PAGOS Y FACTURAS: FALTA IMPLEMENTAR -->
                <Border Background="White" BorderBrush="#C8D1D9" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20" MinHeight="85">
                    <TextBlock Text="Pagos y facturas" FontSize="18" FontWeight="Bold" Foreground="#17483D"/>
                </Border>

                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Cerrar sesión" Width="190" Height="48" HorizontalAlignment="Left" Background="#A52020" Foreground="White" Style="{StaticResource BotonPerfil}" Margin="0" Click="CerrarSesion_Click" Grid.Column="0"/>
            <Button Content="Cerrar" Width="160" Height="48" Grid.Column="1" HorizontalAlignment="Right" Background="#17483D" Foreground="White" Style="{StaticResource BotonPerfil}" Click="MenuButton_Click"/></Grid></StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
