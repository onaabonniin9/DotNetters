<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:GenteFit.WPF" x:Class="GenteFit.WPF.MisReservasWindow" mc:Ignorable="d" Title="GenteFit - Mis Reservas y Lista de Espera" Height="760" Width="1024" MinHeight="650" MinWidth="850" WindowStartupLocation="CenterScreen" Background="#FBF8F1" FontFamily="Poppins">

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:CabeceraClienteControl Grid.Row="0" Margin="0,0,0,12" InicioSolicitado="Cabecera_InicioSolicitado" CerrarSesionSolicitado="Cabecera_CerrarSesionSolicitado"/><TextBlock Grid.Row="1" Text="Mis reservas" FontSize="28" FontWeight="Bold" Foreground="#17483D" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <TextBlock Text="Clases reservadas" FontSize="18" FontWeight="Bold" Foreground="#17483D" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="IcReservas" Margin="0,0,0,10">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#FBF8F1" BorderBrush="#8FA9A1" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="145"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding HoraFormateada}" FontSize="18" FontWeight="Bold" Foreground="#17483D" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">

                                            <TextBlock Text="{Binding ActividadNombre}" FontSize="18" FontWeight="Bold" Foreground="#252A27"/>

                                            <TextBlock Text="{Binding FechaTexto}" FontSize="13" Foreground="#555555" Margin="0,3,0,0"/>

                                            <TextBlock Text="{Binding EstadoTexto}" FontSize="12" FontWeight="SemiBold" Foreground="#17483D" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="{Binding TextoBotonCancelar}" Background="#8B0000" Foreground="White" FontWeight="SemiBold" FontSize="12" Height="36" Padding="8,0" Cursor="Hand" IsEnabled="{Binding PuedeCancelar}" Click="BtnCancelarReserva_Click" Tag="{Binding ReservaId}">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="FondoBoton" Background="{TemplateBinding Background}" CornerRadius="4">

                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FondoBoton" Property="Opacity" Value="0.85"/>
                                                        </Trigger>

                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="FondoBoton" Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="TxtSinReservas" Text="Todavía no tienes reservas." FontSize="13" Foreground="#65756E" Margin="0,0,0,20" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <TextBlock Text="Lista de espera" FontSize="18" FontWeight="Bold" Foreground="#17483D" Margin="0,10,0,10"/>

                    <ItemsControl x:Name="IcListaEspera">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#FBF8F1" BorderBrush="#8FA9A1" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="145"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding HoraFormateada}" FontSize="18" FontWeight="Bold" Foreground="#17483D" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">

                                            <TextBlock Text="{Binding ActividadNombre}" FontSize="18" FontWeight="Bold" Foreground="#252A27"/>

                                            <TextBlock Text="{Binding FechaTexto}" FontSize="13" Foreground="#555555" Margin="0,3,0,0"/>

                                            <TextBlock Text="{Binding PosicionTexto}" FontSize="13" FontWeight="Bold" Foreground="#8B0000" Margin="0,3,0,0"/>

                                            <TextBlock Text="{Binding EstadoTexto}" FontSize="12" FontWeight="SemiBold" Foreground="#17483D" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="{Binding TextoBotonAbandonar}" Background="#8B0000" Foreground="White" FontWeight="SemiBold" FontSize="12" Height="36" Padding="8,0" Cursor="Hand" IsEnabled="{Binding PuedeAbandonar}" Click="BtnSalirListaEspera_Click" Tag="{Binding ListaId}">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="FondoBoton" Background="{TemplateBinding Background}" CornerRadius="4">

                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FondoBoton" Property="Opacity" Value="0.85"/>
                                                        </Trigger>

                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="FondoBoton" Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="TxtSinListaEspera" Text="No tienes entradas en lista de espera." FontSize="13" Foreground="#65756E" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
        <Button Grid.Row="3" Content="Cerrar" Width="160" Height="48"
                HorizontalAlignment="Right" Margin="0,14,0,0"
                FontFamily="Poppins" FontSize="15" FontWeight="SemiBold"
                Foreground="White" Background="#17483D" BorderThickness="0"
                Cursor="Hand" Click="Volver_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
