<Window x:Class="GenteFit.WPF.PerfilClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GenteFit.WPF"
        Title="GenteFit - Perfil del Cliente"
        Height="768"
        Width="1024"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#FBF8F1"
        FontFamily="Poppins">

    <Window.Resources>
        <Style x:Key="CampoPerfil" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#252A27"/>
            <Setter Property="Background" Value="#EDF3F0"/>
            <Setter Property="BorderBrush" Value="#C8D1D9"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="EtiquetaPerfil" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="BotonPerfil" TargetType="Button">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordeBoton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordeBoton" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BordeBoton" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:CabeceraClienteControl Grid.Row="0"
                                     Margin="30,12,30,0"
                                     InicioSolicitado="Cabecera_InicioSolicitado"
                                     CerrarSesionSolicitado="Cabecera_CerrarSesionSolicitado"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="30,18">
            <StackPanel MaxWidth="900"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="Mi perfil"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#17483D"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,18"/>

                <Border Background="White"
                        BorderBrush="#C8D1D9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Datos personales"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17483D"
                                   Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nombre" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtNombre" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Apellidos" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtApellidos" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Nombre de usuario" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtUsuario" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Email" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtEmail" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Teléfono" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtTelefono" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="DNI" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtDNI" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha de nacimiento" Style="{StaticResource EtiquetaPerfil}"/>
                                <DatePicker x:Name="DpFechaNacimiento"
                                            FontFamily="Poppins"
                                            FontSize="14"
                                            Background="#EDF3F0"
                                            Foreground="#252A27"
                                            BorderBrush="#C8D1D9"
                                            IsEnabled="False"
                                            Margin="0,0,0,15"/>

                                <TextBlock Text="Dirección" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtDireccion" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Ciudad" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtCiudad" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Código postal" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtCodigoPostal" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="IBAN" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtIban" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel HorizontalAlignment="Right"
                                   ItemHeight="56"
                                   Margin="0,8,0,0">
                            <Button x:Name="BtnEditarPerfil"
                                    Content="Editar perfil"
                                    Width="140"
                                    Background="#17483D"
                                    Foreground="White"
                                    Style="{StaticResource BotonPerfil}"
                                    Click="EditarPerfil_Click"
                                    Margin="0,0,10,8"/>

                            <Button x:Name="BtnGuardarPerfil"
                                    Content="Guardar cambios"
                                    Width="155"
                                    Background="#17483D"
                                    Foreground="White"
                                    Style="{StaticResource BotonPerfil}"
                                    Visibility="Collapsed"
                                    Click="GuardarPerfil_Click"
                                    Margin="0,0,10,8"/>

                            <Button x:Name="BtnCancelarEdicion"
                                    Content="Cancelar"
                                    Width="110"
                                    Background="#C8D1D9"
                                    Foreground="#252A27"
                                    Style="{StaticResource BotonPerfil}"
                                    Visibility="Collapsed"
                                    Click="CancelarEdicion_Click"
                                    Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- PAGOS Y FACTURAS: AHORA SÍ IMPLEMENTADO -->
                <Border Background="White"
                        BorderBrush="#C8D1D9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Pagos"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#17483D"
                                Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                    Text="Importe"
                                    Style="{StaticResource EtiquetaPerfil}"
                                    Margin="5,0"/>

                            <TextBlock Grid.Column="1"
                                    Text="Concepto"
                                    Style="{StaticResource EtiquetaPerfil}"
                                    Margin="5,0"/>

                            <TextBlock Grid.Column="2"
                                    Text="Estado"
                                    Style="{StaticResource EtiquetaPerfil}"
                                    Margin="5,0"/>

                            <TextBlock Grid.Column="3"
                                    Text="Fecha pagado"
                                    Style="{StaticResource EtiquetaPerfil}"
                                    Margin="5,0"/>

                            <TextBlock Grid.Column="4"
                                    Text="Factura"
                                    Style="{StaticResource EtiquetaPerfil}"
                                    Margin="5,0"/>

                        </Grid>

                        <ItemsControl x:Name="ItemsPagos"
                                    Visibility="Collapsed">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border BorderBrush="#EDF3F0"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,11">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.25*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                    Text="{Binding ImporteTexto}"
                                                    FontFamily="Poppins"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#252A27"
                                                    VerticalAlignment="Center"
                                                    Margin="5,0"/>

                                            <TextBlock Grid.Column="1"
                                                    Text="{Binding Concepto}"
                                                    FontFamily="Poppins"
                                                    FontSize="13"
                                                    Foreground="#252A27"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Concepto}"
                                                    Margin="5,0"/>

                                            <Border Grid.Column="2"
                                                    Background="#EDF3F0"
                                                    CornerRadius="12"
                                                    Padding="7,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="5,0">

                                                <TextBlock Text="{Binding Estado}"
                                                        FontFamily="Poppins"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{Binding EstadoColor}"/>

                                            </Border>

                                            <TextBlock Grid.Column="3"
                                                    Text="{Binding FechaPagadoTexto}"
                                                    FontFamily="Poppins"
                                                    FontSize="13"
                                                    Foreground="#252A27"
                                                    VerticalAlignment="Center"
                                                    Margin="5,0"/>

                                            <!-- Pendiente de implementar al integrar Odoo, porque supongo que la factura se obtendrá de ahí? -->
                                            <Button Grid.Column="4"
                                                    Content="Ver Factura"
                                                    Width="105"
                                                    Height="34"
                                                    IsEnabled="False"
                                                    Background="#8FA9A1"
                                                    Foreground="White"
                                                    FontFamily="Poppins"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    BorderThickness="0"
                                                    Padding="6,4"
                                                    Margin="5,0"
                                                    Cursor="Arrow"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <TextBlock x:Name="TxtSinPagos"
                                Text="No hay ningún pago registrado todavía"
                                FontFamily="Poppins"
                                FontSize="13"
                                Foreground="#65756E"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Margin="0,12,0,4"
                                Visibility="Collapsed"/>

                        <TextBlock x:Name="TxtErrorPagos"
                                FontFamily="Poppins"
                                FontSize="13"
                                Foreground="#B42318"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Margin="0,12,0,4"
                                Visibility="Collapsed"/>

                    </StackPanel>

                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="30,0,30,18" MaxWidth="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cerrar sesión" Width="190" Height="48"
                    HorizontalAlignment="Left" Background="#A52020" Foreground="White"
                    Style="{StaticResource BotonPerfil}" Click="CerrarSesion_Click"/>
            <Button Grid.Column="1" Content="Cerrar" Width="160" Height="48"
                    HorizontalAlignment="Right" Background="#17483D" Foreground="White"
                    Style="{StaticResource BotonPerfil}" Click="MenuButton_Click"/>
        </Grid>
    </Grid>
</Window>
