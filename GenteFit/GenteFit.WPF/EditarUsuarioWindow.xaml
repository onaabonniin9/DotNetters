<Window x:Class="GenteFit.WPF.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenteFit - Editar usuario"
        Width="510" Height="530"
        MinWidth="470" MinHeight="530"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FBF8F1"
        FontFamily="Poppins">
    <Window.Resources>
        <Style x:Key="CampoEdicion" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B6C8C1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BotonEdicion" TargetType="Button">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borde" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" Background="White" CornerRadius="15" Padding="28">
        <StackPanel>
            <TextBlock Text="Editar usuario" FontSize="25" FontWeight="Bold"
                       Foreground="#17483D" Margin="0,0,0,6"/>
            <TextBlock x:Name="UsuarioTexto" Foreground="#65756E" FontSize="14"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Nombre" Foreground="#17483D" Margin="0,0,0,5"/>
            <TextBox x:Name="NombreTextBox" Style="{StaticResource CampoEdicion}"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Apellidos" Foreground="#17483D" Margin="0,0,0,5"/>
            <TextBox x:Name="ApellidosTextBox" Style="{StaticResource CampoEdicion}"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Correo electrónico" Foreground="#17483D" Margin="0,0,0,5"/>
            <TextBox x:Name="CorreoTextBox" Style="{StaticResource CampoEdicion}"
                     Margin="0,0,0,22"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Cancelar" Background="#788C83"
                        Style="{StaticResource BotonEdicion}" Margin="0,0,12,0"
                        Click="Cancelar_Click"/>
                <Button x:Name="GuardarButton" Content="Guardar cambios"
                        Background="#17483D" Style="{StaticResource BotonEdicion}"
                        Click="Guardar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
