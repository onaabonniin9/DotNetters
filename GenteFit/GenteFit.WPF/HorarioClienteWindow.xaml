<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:GenteFit.WPF" x:Class="GenteFit.WPF.HorarioClienteWindow" mc:Ignorable="d" Title="GenteFit - Horario de Actividades" Height="760" Width="1024" MinHeight="650" MinWidth="850" WindowStartupLocation="CenterScreen" Background="#FBF8F1" FontFamily="Poppins">

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:CabeceraClienteControl Grid.Row="0" Margin="0,0,0,12" InicioSolicitado="Cabecera_InicioSolicitado" CerrarSesionSolicitado="Cabecera_CerrarSesionSolicitado"/><TextBlock Grid.Row="1" Text="Horario" FontSize="28" FontWeight="Bold" Foreground="#17483D" HorizontalAlignment="Center" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" x:Name="TxtSubtituloHorario" Text="Clases disponibles" FontSize="16" Foreground="#17483D" HorizontalAlignment="Left" Margin="10,0,0,15"/>

        <Border Grid.Row="3" BorderBrush="#8FA9A1" BorderThickness="3" CornerRadius="6" Background="White" Padding="15">

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="IcSesiones">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <StackPanel>
                                    <Grid Margin="0,5,0,5" MinHeight="90">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding HoraFormateada}" FontSize="18" FontWeight="Medium" Foreground="#252A27" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,15,0">

                                            <TextBlock Text="{Binding NombreActividad}" FontSize="21" FontWeight="Bold" Foreground="#17483D" Margin="0,0,0,2"/>

                                            <TextBlock Text="{Binding FechaFormateada}" FontSize="12" FontWeight="SemiBold" Foreground="#65756E" Margin="0,0,0,3"/>

                                            <TextBlock Text="{Binding DescripcionActividad}" FontSize="12" Foreground="#555555" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>

                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#FBF8F1" BorderBrush="#8FA9A1" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="8" VerticalAlignment="Center" Height="65">

                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                                    <TextBlock Text="{Binding DisponibilidadTitulo}" FontSize="10" Foreground="#252A27" TextAlignment="Center" TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding DisponibilidadTexto}" FontSize="12" FontWeight="Bold" Foreground="#17483D" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <Button Content="Ver detalles" Background="#8FA9A1" Foreground="#17483D" FontSize="12" FontWeight="SemiBold" Height="28" Margin="0,0,0,4" Cursor="Hand" Click="BtnVerDetalles_Click" Tag="{Binding SesionId}">

                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">

                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Content="{Binding TextoBotonAccion}" Background="#17483D" Foreground="White" FontSize="11" FontWeight="SemiBold" Height="28" Cursor="Hand" IsEnabled="{Binding PuedeSolicitar}" Click="BtnAccionSesion_Click" Tag="{Binding SesionId}">

                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">

                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <Separator Background="#E5E7EB" Margin="0,5,0,5"/>
                                </StackPanel>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="TxtEstadoHorario" Text="Cargando sesiones..." FontSize="15" Foreground="#65756E" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Visible" IsHitTestVisible="False" Margin="20"/>
            </Grid>
        </Border>
    </Grid>
</Window>
