<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:GenteFit.WPF" xmlns:componentes="clr-namespace:GenteFit.WPF.Components" x:Class="GenteFit.WPF.HorarioClienteWindow" mc:Ignorable="d" Title="GenteFit - Horario de Actividades" Height="760" Width="1024" MinHeight="650" MinWidth="850" WindowStartupLocation="CenterScreen" Background="#FBF8F1" FontFamily="Poppins">

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Logo_Click">

                <Viewbox Width="48" Height="48">
                    <Canvas Width="100" Height="100">

                        <Ellipse Width="90" Height="90" Canvas.Left="5" Canvas.Top="5" Stroke="#17483D" StrokeThickness="7"/>

                        <Rectangle Width="62" Height="7" Canvas.Left="19" Canvas.Top="46" Fill="#17483D"/>

                        <Rectangle Width="10" Height="27" Canvas.Left="18" Canvas.Top="36" RadiusX="5" RadiusY="5" Fill="#17483D"/>

                        <Rectangle Width="10" Height="27" Canvas.Left="72" Canvas.Top="36" RadiusX="5" RadiusY="5" Fill="#17483D"/>

                        <Rectangle Width="9" Height="22" Canvas.Left="28" Canvas.Top="39" RadiusX="4" RadiusY="4" Fill="#8FA9A1"/>

                        <Rectangle Width="9" Height="22" Canvas.Left="63" Canvas.Top="39" RadiusX="4" RadiusY="4" Fill="#8FA9A1"/>
                    </Canvas>
                </Viewbox>

                <TextBlock FontFamily="DM Sans" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="Gente" Foreground="#17483D"/>
                    <Run Text="Fit" Foreground="#8FA9A1"/>
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="1" Height="42" Background="#C8D1D9" BorderBrush="#8FA9A1" BorderThickness="2" CornerRadius="22" Padding="15,0" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Canvas Width="24" Height="27">
                        <Ellipse Width="12" Height="12" Canvas.Left="6" Canvas.Top="1" Fill="#17483D"/>

                        <Path Data="M 1,26 L 1,23 C 1,14 23,14 23,23 L 23,26 Z" Fill="#17483D"/>
                    </Canvas>

                    <TextBlock Text="Cliente" FontSize="16" FontWeight="Bold" Foreground="#17483D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MenuMisReservas_Click">

                <TextBlock Text="Mis reservas" FontSize="16" FontWeight="SemiBold" Foreground="#17483D" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBlock Text="📋" FontSize="16" Foreground="#17483D" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="Horario" FontSize="28" FontWeight="Bold" Foreground="#17483D" HorizontalAlignment="Center" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" x:Name="TxtSubtituloHorario" Text="Clases disponibles" FontSize="16" Foreground="#17483D" HorizontalAlignment="Left" Margin="10,0,0,15"/>

        <Border Grid.Row="3" BorderBrush="#8FA9A1" BorderThickness="3" CornerRadius="6" Background="White" Padding="15">

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="IcSesiones">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <StackPanel>
                                    <Grid Margin="0,5,0,5" MinHeight="90">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding HoraFormateada}" FontSize="18" FontWeight="Medium" Foreground="#252A27" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,15,0">

                                            <TextBlock Text="{Binding NombreActividad}" FontSize="21" FontWeight="Bold" Foreground="#17483D" Margin="0,0,0,2"/>

                                            <TextBlock Text="{Binding FechaFormateada}" FontSize="12" FontWeight="SemiBold" Foreground="#65756E" Margin="0,0,0,3"/>

                                            <TextBlock Text="{Binding DescripcionActividad}" FontSize="12" Foreground="#555555" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>

                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#FBF8F1" BorderBrush="#8FA9A1" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="8" VerticalAlignment="Center" Height="65">

                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                                    <TextBlock Text="{Binding DisponibilidadTitulo}" FontSize="10" Foreground="#252A27" TextAlignment="Center" TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding DisponibilidadTexto}" FontSize="12" FontWeight="Bold" Foreground="#17483D" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <Button Content="Ver detalles" Background="#8FA9A1" Foreground="#17483D" FontSize="12" FontWeight="SemiBold" Height="28" Margin="0,0,0,4" Cursor="Hand" Click="BtnVerDetalles_Click" Tag="{Binding SesionId}">

                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">

                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Content="{Binding TextoBotonAccion}" Background="#17483D" Foreground="White" FontSize="11" FontWeight="SemiBold" Height="28" Cursor="Hand" IsEnabled="{Binding PuedeSolicitar}" Click="BtnAccionSesion_Click" Tag="{Binding SesionId}">

                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">

                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <Separator Background="#E5E7EB" Margin="0,5,0,5"/>
                                </StackPanel>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="TxtEstadoHorario" Text="Cargando sesiones..." FontSize="15" Foreground="#65756E" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Visible" IsHitTestVisible="False" Margin="20"/>
            </Grid>
        </Border>
    <componentes:CabeceraComun Grid.Row="0" Rol="Cliente"/></Grid>
</Window>