<Window x:Class="GenteFit.WPF.EditarSalaAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenteFit - Sala" Width="620" Height="490"
        MinWidth="530" MinHeight="460" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#FBF8F1" FontFamily="Poppins">
    <Window.Resources>
        <Style x:Key="Accion" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#C9DAD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3C7667"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="18" Margin="24" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock x:Name="TituloTextBlock" Text="Nueva sala" FontSize="26"
                           FontWeight="Bold" Foreground="#17483D"/>
                <TextBlock Text="Configura los datos de la sala" FontSize="13"
                           Foreground="#71877F" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,16,0">
                <TextBlock Text="Nombre de la sala" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="NombreTextBox" MaxLength="150"/>
                <TextBlock Text="Capacidad (número de plazas)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="CapacidadTextBox" MaxLength="6"/>
                <TextBlock Text="La capacidad debe ser un número entero mayor que cero."
                           Foreground="#71877F" FontSize="12"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar" Background="#81968D"
                        Style="{StaticResource Accion}" Click="Cancelar_Click"/>
                <Button x:Name="GuardarButton" Grid.Column="2" Content="Guardar sala"
                        Background="#17483D" Style="{StaticResource Accion}" Click="Guardar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
