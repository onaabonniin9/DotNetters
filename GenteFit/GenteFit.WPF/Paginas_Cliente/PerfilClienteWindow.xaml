<Window x:Class="GenteFit.WPF.PerfilClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenteFit - Perfil del Cliente"
        Height="768"
        Width="1024"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#FBF8F1"
        FontFamily="Poppins">

    <Window.Resources>
        <Style x:Key="CampoPerfil" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#252A27"/>
            <Setter Property="Background" Value="#EDF3F0"/>
            <Setter Property="BorderBrush" Value="#C8D1D9"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="EtiquetaPerfil" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="BotonPerfil" TargetType="Button">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FBF8F1"
                BorderBrush="#EDF3F0"
                BorderThickness="0,0,0,1">
            <Grid Margin="30,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonUp="Logo_Click">
                    <Viewbox Width="48" Height="48">
                        <Canvas Width="100" Height="100">
                            <Ellipse Width="90" Height="90"
                                     Canvas.Left="5" Canvas.Top="5"
                                     Stroke="#17483D" StrokeThickness="7"/>
                            <Rectangle Width="62" Height="7"
                                       Canvas.Left="19" Canvas.Top="46"
                                       Fill="#17483D"/>
                            <Rectangle Width="10" Height="27"
                                       Canvas.Left="18" Canvas.Top="36"
                                       RadiusX="5" RadiusY="5"
                                       Fill="#17483D"/>
                            <Rectangle Width="10" Height="27"
                                       Canvas.Left="72" Canvas.Top="36"
                                       RadiusX="5" RadiusY="5"
                                       Fill="#17483D"/>
                            <Rectangle Width="9" Height="22"
                                       Canvas.Left="28" Canvas.Top="39"
                                       RadiusX="4" RadiusY="4"
                                       Fill="#8FA9A1"/>
                            <Rectangle Width="9" Height="22"
                                       Canvas.Left="63" Canvas.Top="39"
                                       RadiusX="4" RadiusY="4"
                                       Fill="#8FA9A1"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock FontFamily="DM Sans"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0">
                        <Run Text="Gente" Foreground="#17483D"/>
                        <Run Text="Fit" Foreground="#8FA9A1"/>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1"
                        Height="42"
                        Background="#C8D1D9"
                        BorderBrush="#8FA9A1"
                        BorderThickness="2"
                        CornerRadius="22"
                        Padding="15,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Canvas Width="24" Height="27">
                            <Ellipse Width="12" Height="12"
                                     Canvas.Left="6" Canvas.Top="1"
                                     Fill="#17483D"/>
                            <Path Data="M 1,26 L 1,23 C 1,14 23,14 23,23 L 23,26 Z"
                                  Fill="#17483D"/>
                        </Canvas>
                        <TextBlock Text="Cliente"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#17483D"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        Content="Volver al panel  ‹"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Foreground="#17483D"
                        BorderBrush="Transparent"
                        FontFamily="Poppins"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Padding="8,6"
                        Cursor="Hand"
                        Click="MenuButton_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="30,18">
            <StackPanel MaxWidth="900"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="Mi perfil"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#17483D"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,18"/>

                <Border Background="White"
                        BorderBrush="#C8D1D9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Datos personales"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17483D"
                                   Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nombre" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtNombre" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Apellidos" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtApellidos" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Nombre de usuario" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtUsuario" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Email" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtEmail" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Teléfono" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtTelefono" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="DNI" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtDNI" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha de nacimiento" Style="{StaticResource EtiquetaPerfil}"/>
                                <DatePicker x:Name="DpFechaNacimiento"
                                            FontFamily="Poppins"
                                            FontSize="14"
                                            Background="#EDF3F0"
                                            Foreground="#252A27"
                                            BorderBrush="#C8D1D9"
                                            IsEnabled="False"
                                            Margin="0,0,0,15"/>

                                <TextBlock Text="Dirección" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtDireccion" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Ciudad" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtCiudad" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="Código postal" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtCodigoPostal" Style="{StaticResource CampoPerfil}"/>

                                <TextBlock Text="IBAN" Style="{StaticResource EtiquetaPerfil}"/>
                                <TextBox x:Name="TxtIban" Style="{StaticResource CampoPerfil}"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel HorizontalAlignment="Right"
                                   ItemHeight="40"
                                   Margin="0,8,0,0">
                            <Button x:Name="BtnEditarPerfil"
                                    Content="Editar perfil"
                                    Width="140"
                                    Background="#17483D"
                                    Foreground="White"
                                    Style="{StaticResource BotonPerfil}"
                                    Click="EditarPerfil_Click"
                                    Margin="0,0,10,8"/>

                            <Button x:Name="BtnGuardarPerfil"
                                    Content="Guardar cambios"
                                    Width="155"
                                    Background="#17483D"
                                    Foreground="White"
                                    Style="{StaticResource BotonPerfil}"
                                    Visibility="Collapsed"
                                    Click="GuardarPerfil_Click"
                                    Margin="0,0,10,8"/>

                            <Button x:Name="BtnCancelarEdicion"
                                    Content="Cancelar"
                                    Width="110"
                                    Background="#C8D1D9"
                                    Foreground="#252A27"
                                    Style="{StaticResource BotonPerfil}"
                                    Visibility="Collapsed"
                                    Click="CancelarEdicion_Click"
                                    Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- PAGOS Y FACTURAS: FALTA IMPLEMENTAR -->
                <Border Background="White"
                        BorderBrush="#C8D1D9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        Margin="0,0,0,20"
                        MinHeight="85">
                    <TextBlock Text="Pagos y facturas"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#17483D"/>
                </Border>

                <Button Content="Cerrar sesión"
                        Width="180"
                        Height="44"
                        HorizontalAlignment="Center"
                        Background="#17483D"
                        Foreground="White"
                        Style="{StaticResource BotonPerfil}"
                        Margin="0,0,0,20"
                        Click="CerrarSesion_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
