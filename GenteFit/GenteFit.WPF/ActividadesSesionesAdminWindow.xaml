<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:componentes="clr-namespace:GenteFit.WPF.Components" x:Class="GenteFit.WPF.ActividadesSesionesAdminWindow" Title="GenteFit - Actividades y sesiones" Width="1080" Height="720" MinWidth="800" MinHeight="550" WindowStartupLocation="CenterOwner" Background="#FBF8F1" FontFamily="Poppins">
    <Window.Resources>
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Misma presentación de tablas que Gestión de usuarios. -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D5E2DA"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EEE9"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="64"/>
            <Setter Property="ColumnHeaderHeight" Value="54"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F6FAF8"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9F1EC"/>
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#D5E2DA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF4EE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCECE3"/>
                    <Setter Property="Foreground" Value="#17483D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="TextoCeldaCentrado" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="TextoEstado" TargetType="TextBlock" BasedOn="{StaticResource TextoCeldaCentrado}">
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Inactiva">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Cancelada">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions><componentes:CabeceraComun Grid.Row="0" Rol="Administrador" Margin="45,12,45,0"/><Grid Margin="45,32" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Actividades y sesiones" FontSize="30" FontWeight="Bold" Foreground="#17483D"/>
                <TextBlock Text="Consulta de las actividades y sesiones registradas en GenteFit" Foreground="#71877F" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar" Width="130" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="Actualizar_Click" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="EstadoTextBlock" Grid.Row="1" Foreground="#71877F" FontSize="13" Margin="0,0,0,14"/>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#D6E3DD" FontSize="15">
            <TabItem Header="Actividades" Padding="16,8">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Nueva actividad" Width="155" Background="#17483D" Style="{StaticResource BotonRedondeado}" Click="NuevaActividad_Click"/>
                        <Button Content="Editar seleccionada" Width="170" Margin="10,0,0,0" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="EditarActividad_Click"/>
                        <Button Content="Activar / desactivar" Width="180" Margin="10,0,0,0" Background="#A32020" Style="{StaticResource BotonRedondeado}" Click="CambiarEstadoActividad_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="White" BorderBrush="#C8D8D0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <DataGrid x:Name="ActividadesDataGrid">
                        <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="65"/>
                        <DataGridTextColumn Header="Actividad" Binding="{Binding Nombre}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="2*"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="3*"/>
                        <DataGridTextColumn Header="Intensidad" Binding="{Binding Intensidad}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="*"/>
                        <DataGridTextColumn Header="Duración (min)" Binding="{Binding Duracion}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="*"/>
                        </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Sesiones" Padding="16,8">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Nueva sesión" Width="155" Background="#17483D" Style="{StaticResource BotonRedondeado}" Click="NuevaSesion_Click"/>
                        <Button Content="Editar seleccionada" Width="170" Margin="10,0,0,0" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="EditarSesion_Click"/>
                        <Button Content="Cancelar sesión" Width="165" Margin="10,0,0,0" Background="#A32020" Style="{StaticResource BotonRedondeado}" Click="CancelarSesion_Click"/>
                        <Button Content="Gestionar salas" Width="150" Margin="10,0,0,0" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="GestionarSalas_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="White" BorderBrush="#C8D8D0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <DataGrid x:Name="SesionesDataGrid">
                        <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="60"/>
                        <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="2*"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="*"/>
                        <DataGridTextColumn Header="Inicio" Binding="{Binding Inicio}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="*"/>
                        <DataGridTextColumn Header="Fin" Binding="{Binding Fin}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="*"/>
                        <DataGridTextColumn Header="Sala" Binding="{Binding Sala}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="*"/>
                        <DataGridTextColumn Header="Monitor" Binding="{Binding Monitor}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="2*"/>
                        <DataGridTextColumn Header="Plazas" Binding="{Binding Plazas}" ElementStyle="{StaticResource TextoCeldaCentrado}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="*"/>
                        </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="3" Content="Cerrar" Width="160" Background="#17483D" HorizontalAlignment="Right" Margin="0,20,0,0" Style="{StaticResource BotonRedondeado}" Click="Cerrar_Click"/>
    </Grid>
</Grid></Window>