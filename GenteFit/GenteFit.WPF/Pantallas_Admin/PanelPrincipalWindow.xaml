<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:componentes="clr-namespace:GenteFit.WPF.Components" x:Class="GenteFit.WPF.PanelPrincipalWindow" Title="GenteFit - Administración" Width="1100" Height="750" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowState="Normal" SizeToContent="Manual" ShowInTaskbar="True" Background="#FBF8F1" FontFamily="Poppins">


    <Window.Resources>

        <SolidColorBrush x:Key="Verde" Color="#17483D"/>
        <SolidColorBrush x:Key="Secundario" Color="#8FA9A1"/>
        <SolidColorBrush x:Key="Texto" Color="#252A27"/>

        <Style x:Key="Tarjeta" TargetType="Button">
            <Setter Property="Height" Value="118"/>
            <Setter Property="Margin" Value="0,0,0,33"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#17483D"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="30,10"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="#EDF3F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonFichaRedondeado" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordeBoton" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordeBoton" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BordeBoton" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#17483D"/>
        </Style>

        <Style x:Key="DescripcionTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#252A27"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="Flecha" TargetType="TextBlock">
            <Setter Property="Text" Value="❯"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="75,45,75,25">

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <Grid Grid.Row="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Logotipo pequeño -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">

                <Viewbox Width="48" Height="48">
                    <Canvas Width="100" Height="100">
                        <Ellipse Width="90" Height="90" Canvas.Left="5" Canvas.Top="5" Stroke="#17483D" StrokeThickness="7"/>

                        <Rectangle Width="62" Height="7" Canvas.Left="19" Canvas.Top="46" Fill="#17483D"/>

                        <Rectangle Width="10" Height="27" Canvas.Left="18" Canvas.Top="36" RadiusX="5" RadiusY="5" Fill="#17483D"/>

                        <Rectangle Width="10" Height="27" Canvas.Left="72" Canvas.Top="36" RadiusX="5" RadiusY="5" Fill="#17483D"/>

                        <Rectangle Width="9" Height="22" Canvas.Left="28" Canvas.Top="39" RadiusX="4" RadiusY="4" Fill="#8FA9A1"/>

                        <Rectangle Width="9" Height="22" Canvas.Left="63" Canvas.Top="39" RadiusX="4" RadiusY="4" Fill="#8FA9A1"/>
                    </Canvas>
                </Viewbox>

                <TextBlock FontFamily="DM Sans" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="Gente" Foreground="#17483D"/>
                    <Run Text="Fit" Foreground="#8FA9A1"/>
                </TextBlock>
            </StackPanel>

            <!-- Identificación provisional del rol -->
            <Border Grid.Column="1" Height="42" Background="#C8D1D9" BorderBrush="#8FA9A1" BorderThickness="2" CornerRadius="22" Padding="15,0" VerticalAlignment="Top">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Canvas Width="24" Height="27">
                        <Ellipse Width="12" Height="12" Canvas.Left="6" Canvas.Top="1" Fill="#17483D"/>
                        <Path Data="M 1,26 L 1,23 C 1,14 23,14 23,23 L 23,26 Z" Fill="#17483D"/>
                    </Canvas>

                    <TextBlock Text="Administrador" FontSize="16" FontWeight="Bold" Foreground="#17483D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Menú hamburguesa -->
            <Button x:Name="MenuButton" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MenuButton_Click">

                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Inicio" Click="MenuInicio_Click"/>
                        <Separator/>
                        <MenuItem Header="Cerrar sesión" Click="MenuCerrarSesion_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Menú" FontSize="21" FontWeight="SemiBold" Foreground="#17483D" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <Canvas Width="34" Height="30">
                        <Line X1="1" Y1="6" X2="33" Y2="6" Stroke="#17483D" StrokeThickness="2"/>
                        <Line X1="1" Y1="15" X2="33" Y2="15" Stroke="#17483D" StrokeThickness="2"/>
                        <Line X1="1" Y1="24" X2="33" Y2="24" Stroke="#17483D" StrokeThickness="2"/>
                    </Canvas>
                </StackPanel>
            </Button>
        </Grid>

        <!-- PANTALLA DE INICIO -->
        <ScrollViewer x:Name="InicioPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <StackPanel MaxWidth="1050" HorizontalAlignment="Center" Margin="0,45,0,15">

                <TextBlock Text="Inicio" FontSize="36" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>

                <TextBlock Text="¿Qué quieres gestionar hoy?" FontSize="25" Foreground="Black" HorizontalAlignment="Center" Margin="0,8,0,55"/>

                <!-- USUARIOS -->
                <Button Style="{StaticResource Tarjeta}" Tag="Gestión de usuarios" Click="AbrirSeccion_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="66" Height="60" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Canvas Width="75" Height="65">
                                <Ellipse Width="19" Height="19" Canvas.Left="28" Canvas.Top="4" Fill="#17483D"/>
                                <Path Data="M 19,55 C 19,27 56,27 56,55 Z" Fill="#17483D"/>
                                <Ellipse Width="15" Height="15" Canvas.Left="5" Canvas.Top="15" Fill="#17483D"/>
                                <Path Data="M 0,56 C 0,34 24,31 28,42 L 28,56 Z" Fill="#17483D"/>
                                <Ellipse Width="15" Height="15" Canvas.Left="55" Canvas.Top="15" Fill="#17483D"/>
                                <Path Data="M 47,42 C 51,31 75,34 75,56 L 47,56 Z" Fill="#17483D"/>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Gestión de usuarios" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Consulta y administración de los usuarios registrados en GenteFit." Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Flecha}"/>
                    </Grid>
                </Button>

                <!-- ACTIVIDADES Y SESIONES -->
                <Button Style="{StaticResource Tarjeta}" Tag="Actividades y sesiones" Click="AbrirSeccion_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="65" Height="65" HorizontalAlignment="Left">
                            <Canvas Width="70" Height="70">
                                <Rectangle Width="59" Height="57" Canvas.Left="5" Canvas.Top="9" RadiusX="5" RadiusY="5" Stroke="#17483D" StrokeThickness="3" Fill="Transparent"/>

                                <Line X1="5" Y1="24" X2="64" Y2="24" Stroke="#17483D" StrokeThickness="3"/>

                                <Line X1="18" Y1="2" X2="18" Y2="17" Stroke="#17483D" StrokeThickness="3"/>
                                <Line X1="51" Y1="2" X2="51" Y2="17" Stroke="#17483D" StrokeThickness="3"/>

                                <UniformGrid Rows="3" Columns="3" Width="42" Height="32" Canvas.Left="14" Canvas.Top="30">
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                    <Rectangle Margin="3" Stroke="#17483D" StrokeThickness="2"/>
                                </UniformGrid>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Actividades y sesiones" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Organización de actividades, horarios y sesiones del centro." Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Flecha}"/>
                    </Grid>
                </Button>

                <!-- MONITORES -->
                <Button Style="{StaticResource Tarjeta}" Tag="Monitores" Click="AbrirSeccion_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="62" Height="65" HorizontalAlignment="Left">
                            <Canvas Width="65" Height="70">
                                <Ellipse Width="28" Height="28" Canvas.Left="18" Canvas.Top="1" Fill="#17483D"/>
                                <Path Data="M 8,68 L 8,52 C 8,22 57,22 57,52 L 57,68 Z" Fill="#17483D"/>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Monitores" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Consulta y gestión de los monitores del centro." Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Flecha}"/>
                    </Grid>
                </Button>

                <!-- RESERVAS -->
                <Button Style="{StaticResource Tarjeta}" Tag="Reservas y listas de espera" Click="AbrirSeccion_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="70" Height="68" HorizontalAlignment="Left">
                            <Canvas Width="80" Height="75">
                                <Rectangle Width="58" Height="58" Canvas.Left="3" Canvas.Top="10" Stroke="#17483D" StrokeThickness="2.5" Fill="Transparent"/>
                                <Line X1="3" Y1="25" X2="61" Y2="25" Stroke="#17483D" StrokeThickness="2"/>
                                <Line X1="15" Y1="2" X2="15" Y2="17" Stroke="#17483D" StrokeThickness="3"/>
                                <Line X1="48" Y1="2" X2="48" Y2="17" Stroke="#17483D" StrokeThickness="3"/>

                                <Path Data="M 15,35 L 21,41 M 21,35 L 15,41                                             M 31,35 L 37,41 M 37,35 L 31,41                                             M 15,48 L 21,54 M 21,48 L 15,54                                             M 31,48 L 37,54 M 37,48 L 31,54" Stroke="#17483D" StrokeThickness="2"/>

                                <Ellipse Width="28" Height="28" Canvas.Left="49" Canvas.Top="44" Fill="#FBF8F1" Stroke="#17483D" StrokeThickness="2.5"/>

                                <Path Data="M 55,58 L 60,63 L 70,52" Stroke="#17483D" StrokeThickness="2.5" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Reservas y listas de espera" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Seguimiento de reservas, disponibilidad y listas de espera." Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Flecha}"/>
                    </Grid>
                </Button>

                <!-- CLIENTES XML -->
                <Button Style="{StaticResource Tarjeta}" Click="MenuClientesXml_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&lt;/&gt;"
                                   FontFamily="Consolas"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#17483D"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Clientes XML"
                                       Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Importar y exportar clientes en formato XML."
                                       Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Flecha}"/>
                    </Grid>
                </Button>

                <!-- ODOO -->
                <Button Style="{StaticResource Tarjeta}" Tag="Integración con Odoo" Click="AbrirSeccion_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="70" Height="65" HorizontalAlignment="Left">
                            <Canvas Width="80" Height="75">
                                <Rectangle Width="48" Height="26" Canvas.Left="4" Canvas.Top="35" RadiusX="12" RadiusY="12" Stroke="#17483D" StrokeThickness="4" Fill="Transparent">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="-45" CenterX="28" CenterY="48"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <Rectangle Width="48" Height="26" Canvas.Left="28" Canvas.Top="14" RadiusX="12" RadiusY="12" Stroke="#17483D" StrokeThickness="4" Fill="Transparent">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="-45" CenterX="52" CenterY="27"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Integración con Odoo" Style="{StaticResource TituloTarjeta}"/>
                            <TextBlock Text="Consulta y seguimiento de la integración con el sistema ERP." Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Style="{StaticResource Flecha}"/>
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- CONTENEDOR DE NAVEGACIÓN PROVISIONAL -->
        <Grid x:Name="SeccionPanel" Grid.Row="1" Visibility="Collapsed">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock x:Name="TituloSeccion" FontSize="32" FontWeight="Bold" Foreground="#17483D" TextAlignment="Center"/>

                <TextBlock Text="Pantalla pendiente de integración" FontSize="18" Foreground="#252A27" HorizontalAlignment="Center" Margin="0,20,0,30"/>

                <Button Content="Volver al inicio" Width="210" Height="48" Background="#17483D" Foreground="White" FontSize="16" Cursor="Hand" Click="VolverInicio_Click"/>
            </StackPanel>
        </Grid>


        <!-- GESTIÓN DE USUARIOS -->
        <Grid x:Name="UsuariosPanel" Grid.Row="1" Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <StackPanel Grid.Row="0" Margin="0,25,0,28">

                <TextBlock Text="Gestión de usuarios" FontSize="34" FontWeight="Bold" Foreground="#17483D"/>

                <TextBlock Text="Usuarios registrados en GenteFit" FontSize="17" Foreground="#65756E" Margin="0,7,0,22"/>

                <!-- Botón de regreso -->
                <!-- Buscador de usuarios -->
                <componentes:BuscadorComun x:Name="BuscarUsuarioTextBox" Indicacion="Buscar usuario..." TextChanged="BuscarUsuarioTextBox_TextChanged" Margin="0,22,0,0"/>
            </StackPanel>

            <!-- Contenedor de tabla -->
            <Border Grid.Row="1" Background="White" BorderBrush="#C8D8D0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">

                <DataGrid x:Name="UsuariosDataGrid" Style="{StaticResource TablaAdmin}">

                    <DataGrid.Columns>


                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="65"/>

                        <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>

                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>

                        <DataGridTextColumn Header="Apellidos" Binding="{Binding Surname}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>

                        <DataGridTextColumn Header="Correo electrónico" Binding="{Binding Email}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>


                        <!-- Estado con colores -->
                        <DataGridTemplateColumn Header="Estado" Width="110">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text" Value="Activo"/>
                                                <Setter Property="Foreground" Value="#009C57"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="False">

                                                        <Setter Property="Text" Value="Inactivo"/>
                                                        <Setter Property="Foreground" Value="#A32020"/>
                                                    </DataTrigger>
                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <!-- Consulta de la ficha sin modificar datos -->
                        <DataGridTemplateColumn Header="Ficha" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ver" Width="65" Height="34" Background="#17483D" Foreground="White" BorderThickness="0" Cursor="Hand" Click="VerUsuario_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Ficha de consulta, sobre la tabla de usuarios -->
            <Grid x:Name="DetalleUsuarioPanel" Grid.Row="1" Panel.ZIndex="10" Background="#88000000" Visibility="Collapsed">
                <Border Width="500" MaxHeight="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="12" Padding="28">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Ficha del usuario" FontSize="25" FontWeight="Bold" Foreground="#17483D" Margin="0,0,0,20"/>
                            <TextBlock Text="Identificador" Foreground="#65756E"/>
                            <TextBlock Text="{Binding Id}" FontSize="17" Margin="0,2,0,12"/>
                            <TextBlock Text="Nombre de usuario" Foreground="#65756E"/>
                            <TextBlock Text="{Binding Username}" FontSize="17" Margin="0,2,0,12"/>
                            <TextBlock Text="Nombre" Foreground="#65756E"/>
                            <TextBlock Text="{Binding Name}" FontSize="17" Margin="0,2,0,12"/>
                            <TextBlock Text="Apellidos" Foreground="#65756E"/>
                            <TextBlock Text="{Binding Surname}" FontSize="17" Margin="0,2,0,12"/>
                            <TextBlock Text="Correo electrónico" Foreground="#65756E"/>
                            <TextBlock Text="{Binding Email}" FontSize="17" TextWrapping="Wrap" Margin="0,2,0,12"/>
                            <TextBlock Text="Estado" Foreground="#65756E"/>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,2,0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Activo"/>
                                        <Setter Property="Foreground" Value="#009C57"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Active}" Value="False">
                                                <Setter Property="Text" Value="Inactivo"/>
                                                <Setter Property="Foreground" Value="#A32020"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Cambiar estado con confirmación -->



                            <Button Content="Editar usuario" Width="200" Height="42" Margin="0,0,0,12" Style="{StaticResource BotonFichaRedondeado}" Background="#3C7667" Click="EditarUsuario_Click"/>

                            <Button Content="Cerrar ficha" Width="200" Height="42" Margin="0,0,0,12" Style="{StaticResource BotonFichaRedondeado}" Background="#17483D" Click="CerrarDetalleUsuario_Click"/>

                            <Button x:Name="CambiarEstadoUsuarioButton" Content="Desactivar usuario" Width="200" Height="42" Margin="0" Style="{StaticResource BotonFichaRedondeado}" Background="#A32020" Click="CambiarEstadoUsuario_Click"/>



                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Button Content="Cerrar" Style="{StaticResource BotonCerrarAdmin}" Click="VolverInicio_Click" Grid.Row="2" Margin="0,18,0,0"/>
        </Grid>
        <ContentControl x:Name="ContenidoSeccion" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <componentes:CabeceraComun Grid.Row="0" Rol="Administrador" VerticalAlignment="Top"/>
    </Grid>
</Window>