<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:componentes="clr-namespace:GenteFit.WPF.Components" x:Class="GenteFit.WPF.ReservasListasAdminWindow" Background="#FBF8F1" FontFamily="Poppins">
    <UserControl.Resources>
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextoEstado" TargetType="TextBlock" BasedOn="{StaticResource TextoCeldaAdmin}">
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="CANCELADA">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="CANCELADA POR CENTRO">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="RETIRADO">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Reservas y listas de espera" FontSize="29" FontWeight="Bold" Foreground="#17483D"/>
                <TextBlock Text="Consulta administrativa de las reservas y la cola de espera de GenteFit" Foreground="#71877F" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button x:Name="ActualizarButton" Grid.Column="1" Content="Actualizar" Width="132" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="Actualizar_Click" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="EstadoTextBlock" Grid.Row="1" Foreground="#71877F" FontSize="13" Margin="0,0,0,14"/>

        <componentes:BuscadorComun x:Name="BuscarTextBox" Indicacion="Buscar reserva o lista de espera..." TextChanged="BuscarTextBox_TextChanged" Grid.Row="2" Margin="0,0,0,14"/><TabControl Grid.Row="3" Background="White" BorderBrush="#C8D8D0" FontSize="14">
            <TabItem Header="Reservas" Padding="20,9">
                <Grid>
                    <Border Background="White" BorderBrush="#C8D8D0" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><DataGrid x:Name="ReservasDataGrid" Style="{StaticResource TablaAdmin}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="55"/>
                            <DataGridTextColumn Header="Sesión" Binding="{Binding SesionId}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="70"/>
                            <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="110"/>
                            <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="70"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="1.4*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="1.6*"/>
                            <DataGridTextColumn Header="Creada" Binding="{Binding FechaReserva}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="155"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border><TextBlock x:Name="SinReservasTextBlock" Text="No hay reservas que mostrar." Foreground="#71877F" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
            <TabItem Header="Listas de espera" Padding="20,9">
                <Grid>
                    <Border Background="White" BorderBrush="#C8D8D0" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><DataGrid x:Name="ListasDataGrid" Style="{StaticResource TablaAdmin}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="55"/>
                            <DataGridTextColumn Header="Sesión" Binding="{Binding SesionId}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="70"/>
                            <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="110"/>
                            <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="70"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="1.5*"/>
                            <DataGridTextColumn Header="Posición" Binding="{Binding Posicion}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="85"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border><TextBlock x:Name="SinListasTextBlock" Text="No hay entradas en lista de espera que mostrar." Foreground="#71877F" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="4" Content="Cerrar" Margin="0,18,0,0" Style="{StaticResource BotonCerrarAdmin}" Click="Cerrar_Click"/>
    </Grid>
</UserControl>