<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:componentes="clr-namespace:GenteFit.WPF.Components" x:Class="GenteFit.WPF.MonitoresAdminWindow" Background="#FBF8F1" FontFamily="Poppins">
    <UserControl.Resources>
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextoEstado" TargetType="TextBlock" BasedOn="{StaticResource TextoCeldaAdmin}">
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Inactivo">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Gestión de monitores" FontSize="30" FontWeight="Bold" Foreground="#17483D"/>
                <TextBlock Text="Consulta y mantenimiento de los monitores de GenteFit" Foreground="#71877F" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar" Width="130" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="Actualizar_Click" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="EstadoTextBlock" Grid.Row="1" Foreground="#71877F" FontSize="13" Margin="0,0,0,14"/>
        <componentes:BuscadorComun x:Name="BuscarTextBox" Indicacion="Buscar monitor..." TextChanged="BuscarTextBox_TextChanged" Grid.Row="2" Margin="0,0,0,14"/><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Nuevo monitor" Width="155" Background="#17483D" Style="{StaticResource BotonRedondeado}" Click="NuevoMonitor_Click"/>
            <Button Content="Editar seleccionado" Width="175" Margin="10,0,0,0" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="EditarMonitor_Click"/>
            <Button Content="Activar / desactivar" Width="180" Margin="10,0,0,0" Background="#A32020" Style="{StaticResource BotonRedondeado}" Click="CambiarEstado_Click"/>
        </StackPanel>
        <Border Grid.Row="4" Background="White" BorderBrush="#C8D8D0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <DataGrid x:Name="MonitoresDataGrid" Style="{StaticResource TablaAdmin}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="55"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="1.4*"/>
                    <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="1.5*"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="1.3*"/>
                    <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>
                    <DataGridTextColumn Header="Especialidad" Binding="{Binding Especialidad}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="1.6*"/>
                    <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Button Grid.Row="5" Content="Cerrar" Margin="0,20,0,0" Style="{StaticResource BotonCerrarAdmin}" Click="Cerrar_Click"/>
    </Grid>
</UserControl>