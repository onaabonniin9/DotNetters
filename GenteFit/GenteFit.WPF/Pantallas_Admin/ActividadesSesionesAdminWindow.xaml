<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:componentes="clr-namespace:GenteFit.WPF.Components" x:Class="GenteFit.WPF.ActividadesSesionesAdminWindow" Background="#FBF8F1" FontFamily="Poppins">
    <UserControl.Resources>
        <Style x:Key="BotonRedondeado" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Misma presentación de tablas que Gestión de usuarios. -->
        <Style x:Key="TextoEstado" TargetType="TextBlock" BasedOn="{StaticResource TextoCeldaAdmin}">
            <Setter Property="Foreground" Value="#17483D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Inactiva">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Cancelada">
                    <Setter Property="Foreground" Value="#A32020"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Actividades y sesiones" FontSize="30" FontWeight="Bold" Foreground="#17483D"/>
                <TextBlock Text="Consulta de las actividades y sesiones registradas en GenteFit" Foreground="#71877F" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar" Width="130" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="Actualizar_Click" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="EstadoTextBlock" Grid.Row="1" Foreground="#71877F" FontSize="13" Margin="0,0,0,14"/>

        <componentes:BuscadorComun x:Name="BuscarTextBox" Indicacion="Buscar actividad o sesión..." TextChanged="BuscarTextBox_TextChanged" Grid.Row="2" Margin="0,0,0,14"/><TabControl Grid.Row="3" Background="White" BorderBrush="#D6E3DD" FontSize="15">
            <TabItem Header="Actividades" Padding="16,8">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Nueva actividad" Width="155" Background="#17483D" Style="{StaticResource BotonRedondeado}" Click="NuevaActividad_Click"/>
                        <Button Content="Editar seleccionada" Width="170" Margin="10,0,0,0" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="EditarActividad_Click"/>
                        <Button Content="Activar / desactivar" Width="180" Margin="10,0,0,0" Background="#A32020" Style="{StaticResource BotonRedondeado}" Click="CambiarEstadoActividad_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="White" BorderBrush="#C8D8D0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <DataGrid x:Name="ActividadesDataGrid" Style="{StaticResource TablaAdmin}">
                        <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="65"/>
                        <DataGridTextColumn Header="Actividad" Binding="{Binding Nombre}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="3*"/>
                        <DataGridTextColumn Header="Intensidad" Binding="{Binding Intensidad}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>
                        <DataGridTextColumn Header="Duración (min)" Binding="{Binding Duracion}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="*"/>
                        </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Sesiones" Padding="16,8">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Nueva sesión" Width="155" Background="#17483D" Style="{StaticResource BotonRedondeado}" Click="NuevaSesion_Click"/>
                        <Button Content="Editar seleccionada" Width="170" Margin="10,0,0,0" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="EditarSesion_Click"/>
                        <Button Content="Cancelar sesión" Width="165" Margin="10,0,0,0" Background="#A32020" Style="{StaticResource BotonRedondeado}" Click="CancelarSesion_Click"/>
                        <Button Content="Gestionar salas" Width="150" Margin="10,0,0,0" Background="#3C7667" Style="{StaticResource BotonRedondeado}" Click="GestionarSalas_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="White" BorderBrush="#C8D8D0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <DataGrid x:Name="SesionesDataGrid" Style="{StaticResource TablaAdmin}">
                        <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="60"/>
                        <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>
                        <DataGridTextColumn Header="Inicio" Binding="{Binding Inicio}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>
                        <DataGridTextColumn Header="Fin" Binding="{Binding Fin}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>
                        <DataGridTextColumn Header="Sala" Binding="{Binding Sala}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>
                        <DataGridTextColumn Header="Monitor" Binding="{Binding Monitor}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="2*"/>
                        <DataGridTextColumn Header="Plazas" Binding="{Binding Plazas}" ElementStyle="{StaticResource TextoCeldaAdmin}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" ElementStyle="{StaticResource TextoEstado}" Width="*"/>
                        </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="4" Content="Cerrar" Margin="0,20,0,0" Style="{StaticResource BotonCerrarAdmin}" Click="Cerrar_Click"/>
    </Grid>
</UserControl>